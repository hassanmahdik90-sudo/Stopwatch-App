<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChronoPulse - Stopwatch App</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: '#6366f1'
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;800&family=Inter:wght@400;600;700;800&display=swap');
        body { font-family: 'Inter', sans-serif; }
        .font-mono-time { font-family: 'JetBrains Mono', monospace; }
    </style>
</head>
<body class="bg-slate-100 dark:bg-slate-900 text-slate-800 dark:text-slate-100 min-h-screen flex flex-col transition-colors duration-200">

    <!-- Header -->
    <header class="bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 shadow-sm sticky top-0 z-10">
        <div class="max-w-2xl mx-auto px-4 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-2.5">
                <div class="w-9 h-9 bg-indigo-500 rounded-xl flex items-center justify-center text-white shadow-md">
                    <i class="fa-solid fa-stopwatch text-lg"></i>
                </div>
                <h1 class="text-xl font-extrabold tracking-tight">ChronoPulse</h1>
            </div>
            <button id="theme-toggle" class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 flex items-center justify-center hover:bg-slate-200 dark:hover:bg-slate-600 transition">
                <i class="fa-solid fa-moon"></i>
            </button>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-2xl w-full mx-auto p-4 md:p-6 flex-grow space-y-6">

        <!-- Stopwatch Display Card -->
        <div class="bg-white dark:bg-slate-800 rounded-3xl p-8 border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col items-center justify-center space-y-6">
            
            <!-- Main Timer Readout -->
            <div class="text-center">
                <div id="display" class="font-mono-time text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-slate-800 dark:text-slate-100">
                    00:00:00<span id="display-ms" class="text-2xl sm:text-3xl md:text-4xl text-indigo-500 font-bold">.00</span>
                </div>
                <p id="lap-counter-text" class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider mt-2">
                    Laps recorded: 0
                </p>
            </div>

            <!-- Controls -->
            <div class="flex items-center gap-4 w-full max-w-sm justify-center">
                
                <!-- Lap / Reset Button -->
                <button id="btn-lap-reset" disabled class="flex-1 py-3 px-4 rounded-2xl bg-slate-100 dark:bg-slate-700 text-slate-400 dark:text-slate-500 font-bold text-sm transition flex items-center justify-center gap-2 cursor-not-allowed">
                    <i class="fa-solid fa-flag"></i>
                    <span id="lbl-lap-reset">Lap</span>
                </button>

                <!-- Start / Pause Button -->
                <button id="btn-start-pause" class="flex-1 py-3.5 px-6 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-extrabold text-base transition shadow-lg shadow-indigo-500/30 flex items-center justify-center gap-2">
                    <i id="icon-start-pause" class="fa-solid fa-play"></i>
                    <span id="lbl-start-pause">Start</span>
                </button>

            </div>

            <!-- Shortcuts Info -->
            <div class="flex gap-4 text-[10px] text-slate-400 dark:text-slate-500 font-medium">
                <span><kbd class="px-1.5 py-0.5 bg-slate-100 dark:bg-slate-700 rounded border border-slate-200 dark:border-slate-600">Space</kbd> Start/Pause</span>
                <span><kbd class="px-1.5 py-0.5 bg-slate-100 dark:bg-slate-700 rounded border border-slate-200 dark:border-slate-600">L</kbd> Lap</span>
                <span><kbd class="px-1.5 py-0.5 bg-slate-100 dark:bg-slate-700 rounded border border-slate-200 dark:border-slate-600">R</kbd> Reset</span>
            </div>

        </div>

        <!-- Laps Table -->
        <div class="bg-white dark:bg-slate-800 rounded-3xl p-5 border border-slate-200 dark:border-slate-700 shadow-sm space-y-3">
            <div class="flex justify-between items-center">
                <h3 class="text-xs font-extrabold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                    Lap Split Times
                </h3>
                <span id="lap-summary" class="text-xs font-semibold text-slate-500 dark:text-slate-400"></span>
            </div>

            <div class="max-h-60 overflow-y-auto pr-1">
                <table class="w-full text-left text-sm">
                    <thead class="text-[10px] uppercase font-bold text-slate-400 dark:text-slate-500 border-b border-slate-100 dark:border-slate-700">
                        <tr>
                            <th class="pb-2">Lap #</th>
                            <th class="pb-2 text-center">Split Time</th>
                            <th class="pb-2 text-right">Total Time</th>
                        </tr>
                    </thead>
                    <tbody id="laps-body" class="divide-y divide-slate-100 dark:divide-slate-700/50 font-mono-time">
                        <!-- Dynamic Laps -->
                    </tbody>
                </table>
                <div id="no-laps" class="text-center py-6 text-xs text-slate-400 dark:text-slate-500 italic">
                    No laps recorded yet.
                </div>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="max-w-2xl w-full mx-auto px-4 py-4 text-center text-xs text-slate-400 mt-auto">
        Single-File Web App &bull; Precision Timer &bull; MIT License
    </footer>

    <!-- Application Logic -->
    <script>
        // State Management
        let isRunning = false;
        let startTime = 0;
        let elapsedTime = 0;
        let timerInterval = null;
        let laps = JSON.parse(localStorage.getItem('stopwatch_laps')) || [];

        // Elements
        const display = document.getElementById('display');
        const displayMs = document.getElementById('display-ms');
        const lapCounterText = document.getElementById('lap-counter-text');
        const btnStartPause = document.getElementById('btn-start-pause');
        const lblStartPause = document.getElementById('lbl-start-pause');
        const iconStartPause = document.getElementById('icon-start-pause');
        const btnLapReset = document.getElementById('btn-lap-reset');
        const lblLapReset = document.getElementById('lbl-lap-reset');
        const lapsBody = document.getElementById('laps-body');
        const noLaps = document.getElementById('no-laps');
        const lapSummary = document.getElementById('lap-summary');
        const themeToggleBtn = document.getElementById('theme-toggle');

        // Dark Mode Toggle
        themeToggleBtn.addEventListener('click', () => {
            document.documentElement.classList.toggle('dark');
            const isDark = document.documentElement.classList.contains('dark');
            themeToggleBtn.innerHTML = isDark ? '<i class="fa-solid fa-sun"></i>' : '<i class="fa-solid fa-moon"></i>';
        });

        // Time Formatter
        function formatTime(ms) {
            const hrs = Math.floor(ms / 3600000);
            const mins = Math.floor((ms % 3600000) / 60000);
            const secs = Math.floor((ms % 60000) / 1000);
            const centis = Math.floor((ms % 1000) / 10);

            const pad = num => String(num).padStart(2, '0');

            return {
                main: `${pad(hrs)}:${pad(mins)}:${pad(secs)}`,
                ms: `.${pad(centis)}`
            };
        }

        function updateDisplay() {
            const timeObj = formatTime(elapsedTime);
            display.childNodes[0].textContent = timeObj.main;
            displayMs.textContent = timeObj.ms;
        }

        // Timer Operations
        function startTimer() {
            isRunning = true;
            startTime = Date.now() - elapsedTime;
            timerInterval = setInterval(() => {
                elapsedTime = Date.now() - startTime;
                updateDisplay();
            }, 10);

            lblStartPause.textContent = 'Pause';
            iconStartPause.className = 'fa-solid fa-pause';
            btnStartPause.className = 'flex-1 py-3.5 px-6 rounded-2xl bg-amber-500 hover:bg-amber-600 text-white font-extrabold text-base transition shadow-lg shadow-amber-500/30 flex items-center justify-center gap-2';

            lblLapReset.textContent = 'Lap';
            btnLapReset.disabled = false;
            btnLapReset.className = 'flex-1 py-3 px-4 rounded-2xl bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 font-bold text-sm transition flex items-center justify-center gap-2 cursor-pointer';
        }

        function pauseTimer() {
            isRunning = false;
            clearInterval(timerInterval);

            lblStartPause.textContent = 'Resume';
            iconStartPause.className = 'fa-solid fa-play';
            btnStartPause.className = 'flex-1 py-3.5 px-6 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-extrabold text-base transition shadow-lg shadow-indigo-500/30 flex items-center justify-center gap-2';

            lblLapReset.textContent = 'Reset';
        }

        function resetTimer() {
            isRunning = false;
            clearInterval(timerInterval);
            elapsedTime = 0;
            laps = [];
            localStorage.removeItem('stopwatch_laps');

            updateDisplay();
            renderLaps();

            lblStartPause.textContent = 'Start';
            iconStartPause.className = 'fa-solid fa-play';
            btnStartPause.className = 'flex-1 py-3.5 px-6 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-extrabold text-base transition shadow-lg shadow-indigo-500/30 flex items-center justify-center gap-2';

            lblLapReset.textContent = 'Lap';
            btnLapReset.disabled = true;
            btnLapReset.className = 'flex-1 py-3 px-4 rounded-2xl bg-slate-100 dark:bg-slate-700 text-slate-400 dark:text-slate-500 font-bold text-sm transition flex items-center justify-center gap-2 cursor-not-allowed';
        }

        function recordLap() {
            if (!isRunning) return;

            const previousTotalTime = laps.length > 0 ? laps[0].totalTime : 0;
            const splitTime = elapsedTime - previousTotalTime;

            const lapEntry = {
                number: laps.length + 1,
                splitTime,
                totalTime: elapsedTime
            };

            laps.unshift(lapEntry);
            localStorage.setItem('stopwatch_laps', JSON.stringify(laps));
            renderLaps();
        }

        function renderLaps() {
            lapsBody.innerHTML = '';
            lapCounterText.textContent = `Laps recorded: ${laps.length}`;

            if (laps.length === 0) {
                noLaps.classList.remove('hidden');
                lapSummary.textContent = '';
                return;
            }

            noLaps.classList.add('hidden');

            // Find fastest and slowest splits (if > 1 lap)
            let minSplit = Infinity;
            let maxSplit = -1;

            if (laps.length > 1) {
                laps.forEach(lap => {
                    if (lap.splitTime < minSplit) minSplit = lap.splitTime;
                    if (lap.splitTime > maxSplit) maxSplit = lap.splitTime;
                });
            }

            laps.forEach(lap => {
                const tr = document.createElement('tr');
                tr.className = 'py-2.5 text-xs';

                let badge = '';
                if (laps.length > 1) {
                    if (lap.splitTime === minSplit) badge = '<span class="ml-1 text-[10px] px-1.5 py-0.5 rounded bg-emerald-100 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 font-bold">Fastest</span>';
                    else if (lap.splitTime === maxSplit) badge = '<span class="ml-1 text-[10px] px-1.5 py-0.5 rounded bg-rose-100 dark:bg-rose-950 text-rose-600 dark:text-rose-400 font-bold">Slowest</span>';
                }

                const splitFormatted = formatTime(lap.splitTime);
                const totalFormatted = formatTime(lap.totalTime);

                tr.innerHTML = `
                    <td class="py-2.5 font-bold text-slate-600 dark:text-slate-300">Lap ${lap.number}</td>
                    <td class="py-2.5 text-center font-bold text-slate-800 dark:text-slate-100">${splitFormatted.main}${splitFormatted.ms} ${badge}</td>
                    <td class="py-2.5 text-right text-slate-500 dark:text-slate-400">${totalFormatted.main}${totalFormatted.ms}</td>
                `;
                lapsBody.appendChild(tr);
            });
        }

        // Handlers
        btnStartPause.addEventListener('click', () => {
            if (isRunning) pauseTimer();
            else startTimer();
        });

        btnLapReset.addEventListener('click', () => {
            if (isRunning) recordLap();
            else resetTimer();
        });

        // Keyboard Shortcuts
        window.addEventListener('keydown', (e) => {
            if (e.code === 'Space') {
                e.preventDefault();
                if (isRunning) pauseTimer();
                else startTimer();
            } else if (e.code === 'KeyL' && isRunning) {
                recordLap();
            } else if (e.code === 'KeyR' && !isRunning && elapsedTime > 0) {
                resetTimer();
            }
        });

        // Initial Setup
        if (laps.length > 0) {
            elapsedTime = laps[0].totalTime;
            updateDisplay();
            renderLaps();
            btnLapReset.disabled = false;
            lblLapReset.textContent = 'Reset';
            btnLapReset.className = 'flex-1 py-3 px-4 rounded-2xl bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 font-bold text-sm transition flex items-center justify-center gap-2 cursor-pointer';
        }
    </script>
</body>
</html>
